{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 265,
  "height": 200,
  "data": {"url": "data/speedrun_category_data.csv"},
  "transform": [
    {
      "filter": "datum.Game_Id == 13 && (datum.Category == 'Any%' || (datum.Category == 'Glitchless' && datum.Subcategory == 'Any%,Unrestricted') || (datum.Category == 'No Wrong Warp' && datum.Subcategory == 'No SRM') || (datum.Category == '100%' && datum.Subcategory == 'No SRM'))"
    },
    {
      "calculate": "datum.Category == 'Any%' ? 'Any%' : datum.Category == 'Glitchless' ? 'Any% Glitchless' : datum.Category == 'No Wrong Warp' ? 'No Wrong Warp' : '100%'",
      "as": "Category_Label"
    },
    {
      "calculate": "(datetime('2022-04-01') - datetime(datum.Record_Date_0)) / (1000 * 60 * 60 * 24)",
      "as": "Days_Since_WR"
    },
    {"calculate": "datum.Days_Since_WR / 30", "as": "Months_Since"}
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 20,
        "strokeWidth": 2
      },
      "params": [
        {
          "name": "hover",
          "select": {"type": "point", "on": "mouseover", "clear": "mouseout"}
        }
      ],
      "encoding": {
        "theta": {
          "field": "Category_Label",
          "type": "nominal",
          "stack": false,
          "sort": ["Any%", "Any% Glitchless", "No Wrong Warp", "100%"]
        },
        "radius": {
          "field": "Months_Since",
          "type": "quantitative",
          "scale": {"domain": [0, 15], "range": [20, 100]}
        },
        "color": {
            "field": "Category_Label",
            "type": "nominal",
            "scale": {
                "domain": ["Any%", "Any% Glitchless", "No Wrong Warp", "100%"],
                "range": ["#01a049", "#ff5757", "#5b9bd5", "#9b59b6"]
            },
          "legend": null
        },
        "stroke": {
          "condition": {"param": "hover", "empty": false, "value": "#ff5757"},
          "field": "Category_Label",
          "type": "nominal",
          "scale": {
            "domain": ["Any%", "Any% Glitchless", "No Wrong Warp", "100%"],
            "range": ["#01a049", "#ff5757", "#5b9bd5", "#9b59b6"]
          }
        },
        "strokeWidth": {
            "condition": {"param": "hover", "empty": false, "value": 2.5},
            "value": 0.5
        },
        "opacity": {"value": 0.7},
        "tooltip": [
          {"field": "Category_Label", "type": "nominal", "title": "Category"},
          {"field": "Days_Since_WR", "type": "quantitative", "title": "Days Since WR", "format": ".0f"},
          {"field": "Record_Date_0", "type": "temporal", "title": "WR Date"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radiusOffset": 15,
        "fontSize": 16,
        "font": "VT323",
        "color": "#e6e6e6"
      },
      "encoding": {
        "theta": {
          "field": "Category_Label",
          "type": "nominal",
          "stack": false,
          "sort": ["Any%", "Any% Glitchless", "No Wrong Warp", "100%"]
        },
        "radius": {"value": 110},
        "text": {"field": "Category_Label", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "transparent"
  }
}